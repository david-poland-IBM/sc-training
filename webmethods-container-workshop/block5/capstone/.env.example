# Copy to .env and adapt. Never commit the real .env.
COMPOSE_PROJECT_NAME=wm-block5

# ---- application version (drives the image tag and LAB_VERSION) ----
APP_VERSION=1.0.0

# ---- non-production secrets (compose.yaml only) --------------------
# With compose.prod.yaml these are NOT used - the passwords come from
# ./secrets/*.txt (see scripts/make-secrets.sh).
ADMIN_PASSWORD=ChangeMe-Admin-2026
DB_PASSWORD=ChangeMe-Db-2026
APIGW_ADMIN_PASSWORD=ChangeMe-Gw-2026
DB_USER=wmuser

# ---- pinned images (bump deliberately, one at a time) --------------
MSR_BASE_IMAGE=ibmwebmethods.azurecr.io/webmethods-microservicesruntime:12.1.0.3
UM_IMAGE=ibmwebmethods.azurecr.io/universalmessaging-server:12.1.0.0
APIGW_IMAGE=ibmwebmethods.azurecr.io/apigateway-minimal:11.1.0.14
OPENSEARCH_IMAGE=docker.io/opensearchproject/opensearch:2.19.4
POSTGRES_IMAGE=docker.io/library/postgres:16
NGINX_IMAGE=docker.io/library/nginx:1.27-alpine

# ---- logging overlay (compose.logging.yaml) ------------------------
# GRAYLOG_PASSWORD_SECRET: at least 16 characters
GRAYLOG_PASSWORD_SECRET=ChangeMe-Graylog-Pepper-0123456789
# SHA-256 of the Graylog "admin" password. This default is the hash of: admin
#   printf '%s' 'yourpassword' | shasum -a 256 | cut -d' ' -f1
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
