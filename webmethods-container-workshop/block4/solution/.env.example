# Copy to .env and change the values. Never commit the real .env.
COMPOSE_PROJECT_NAME=wm-block4

# MSR Administrator password (applied via application.properties -> $env{ADMIN_PASSWORD})
ADMIN_PASSWORD=ChangeMe-Admin-2026

# PostgreSQL (business DB used by the SwisscomLab package)
DB_USER=wmuser
DB_PASSWORD=ChangeMe-Db-2026

# Image tags - pin explicitly, bump deliberately
MSR_BASE_IMAGE=ibmwebmethods.azurecr.io/webmethods-microservicesruntime:12.1.0.3
UM_IMAGE=ibmwebmethods.azurecr.io/universalmessaging-server:12.1.0.0
POSTGRES_IMAGE=docker.io/library/postgres:16
