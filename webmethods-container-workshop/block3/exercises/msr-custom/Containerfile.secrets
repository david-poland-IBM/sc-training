# =====================================================================
# Exercise 3.6 (part B) - build arguments vs. build secrets
#   podman build -f block3/exercises/msr-custom/Containerfile.secrets \
#     --build-arg API_TOKEN=s3cr3t-from-arg \
#     --secret id=api_token,src=block3/exercises/msr-custom/token.txt \
#     -t localhost/workshop/secret-demo .
# =====================================================================
FROM docker.io/library/alpine:3.19

# WRONG: a build argument used in RUN is recorded in the image history
ARG API_TOKEN
RUN echo "pretend we download something with token ${API_TOKEN}" > /tmp/with-arg.txt

# RIGHT: a build secret is mounted only for this one RUN step, never stored
RUN --mount=type=secret,id=api_token \
    echo "pretend we download something with token $(cat /run/secrets/api_token)" > /dev/null \
    && echo "secret was available during the build" > /tmp/with-secret.txt
